{
  "manifest_version": 3,
  "name": "GhostWriter",
  "version": "2.0.0",
  "description": "Send your LinkedIn profile and job pages to the local GhostWriter server",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://www.linkedin.com/*", "http://127.0.0.1:3000/*"],
  "action": { "default_popup": "popup.html" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/in/*"],
      "js": ["content-linkedin.js"],
      "run_at": "document_idle"
    }
  ]
}
